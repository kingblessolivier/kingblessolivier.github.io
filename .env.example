# ── AI Assistant (serverless function: netlify/functions/chat) ──
# Anthropic API key — enables the real Claude-powered chatbot.
# Without it, the assistant falls back to the built-in offline bot.
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-4-8).
# Use claude-haiku-4-5 or claude-sonnet-4-6 to trade cost/latency.
CLAUDE_MODEL=

# ── Contact form — pick ONE provider so messages arrive in your inbox ──
#
# Option A: Bird (https://bird.com) email channel. Needs an access key plus the
# workspace and email-channel IDs from your Bird dashboard.
BIRD_ACCESS_KEY=
BIRD_WORKSPACE_ID=
BIRD_CHANNEL_ID=        # the Email channel's ID
CONTACT_TO=            # who receives the message; defaults to the email in src/assets/data.js
#
# Option B (no API key): create a free form at https://formspree.io pointed at
# your email, then paste its endpoint here.
FORMSPREE_ENDPOINT=
#
# Option C: Resend transactional email (https://resend.com). On the free tier
# (no custom domain) the recipient must be the email you signed up with.
RESEND_API_KEY=
CONTACT_FROM=          # Resend only; defaults to "Portfolio <onboarding@resend.dev>"

# Client-side Formspree fallback (build-time). Only needed if you can't set
# server env vars; the serverless options above are preferred.
VITE_FORMSPREE_ENDPOINT=

# Note: the visit counter (netlify/functions/counter) uses Netlify Blobs and
# needs no configuration — it works automatically on Netlify.
